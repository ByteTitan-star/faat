# ── Paper-ready matplotlib style for backdoor attack figures ──
# Usage: plt.style.use('path/to/paper.mplstyle')
# or: from backdoor_paper_style import setup_paper_style; setup_paper_style()

# ── Font ──
font.family: serif
font.serif: Times New Roman, DejaVu Serif, Liberation Serif, serif
font.size: 10
axes.labelsize: 11
axes.titlesize: 12
legend.fontsize: 8.5
xtick.labelsize: 9
ytick.labelsize: 9

# ── Figure ──
figure.dpi: 150
figure.figsize: 7.0, 3.0    # double-column default
savefig.dpi: 600
savefig.bbox: tight
savefig.pad_inches: 0.05
savefig.format: pdf

# ── Axes ──
axes.spines.top: False
axes.spines.right: False
axes.linewidth: 0.8
axes.grid: False
axes.axisbelow: True
# axes.prop_cycle set programmatically in backdoor_paper_style.py for compat

# ── Grid (when enabled) ──
grid.alpha: 0.3
grid.linestyle: --
grid.linewidth: 0.5

# ── Legend ──
legend.frameon: False
legend.loc: best
legend.borderpad: 0.4
legend.handlelength: 1.5
legend.handletextpad: 0.5
legend.columnspacing: 0.8

# ── Lines and markers ──
lines.linewidth: 1.5
lines.markersize: 5
lines.markeredgewidth: 0.5
lines.markeredgecolor: white

# ── Ticks ──
xtick.major.size: 3
xtick.major.width: 0.6
ytick.major.size: 3
ytick.major.width: 0.6
xtick.direction: out
ytick.direction: out

# ── Error bars ──
errorbar.capsize: 2
# errorbar cap thickness set programmatically for mpl 3.7 compat

# ── Bar charts ──
patch.linewidth: 0.5
patch.edgecolor: white

# ── Heatmap / image ──
image.cmap: viridis
image.interpolation: none
